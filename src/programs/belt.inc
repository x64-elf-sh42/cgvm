static void b_inc(unsigned address) {
  sr(2,address);e(ADD_RI(2,1));e(MOV_RI(0,address));f(OP_STORE32,2,0);
}
/* Unsigned 32-bit mixing with high-word feedback; output is a 24-bit fraction.
 * Deliberately uses only existing integer arithmetic and conversion opcodes. */
static void b_random(void) {
  b_imm(2,1664525);f(OP_MUL_RR,3,2);b_imm(2,1013904223);f(OP_ADD_RR,3,2);
  f(OP_MOV_RR,5,3);e(MOV_RI(2,65536));f(OP_DIV_RR,5,2);f(OP_ADD_RR,3,5);
  f(OP_MOV_RR,5,3);e(MOV_RI(2,256));f(OP_DIV_RR,5,2);f(OP_ITOF,4,5);
