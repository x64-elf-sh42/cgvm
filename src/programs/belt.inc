static void b_cell_offset(int x,int y,int z) {
  const int offsets[]={x,y,z};
  for(unsigned k=0;k<3;k++) {
    sl(4,B_ORIGIN+k*8);e(MOV_RI(2,1));f(OP_ITOF,5,2);
    if(offsets[k])f(offsets[k]>0?OP_FADD_RR:OP_FSUB_RR,4,5);
    ss(4,B_CELL+k*8);
  }
}
static void b_update(void) {
  b_origin(S_POS);sr(2,B_VALID);e(CMP_RI(2,0));size_t fresh=pc++;
  size_t changed[3];
  for(unsigned k=0;k<3;k++){sl(4,B_ORIGIN+k*8);sl(5,B_CACHED+k*8);f(OP_FCMP_RR,4,5);changed[k]=pc++;}
