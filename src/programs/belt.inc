/* Guest regional belt. A proxy record lets one mesh program serve every slot.
 * Coordinates/geometry are generated by the VM, never by host callbacks. */
#define B_PROXY (S_BODY+S_CATALOG*64u)
#define B_ORIGIN 10512u
#define B_CELL 10536u
#define B_CACHED 10560u
#define B_VALID 10584u
#define B_INDEX 10588u
#define B_SAMPLE 10600u
#define B_TRAVEL 10624u
#define B_INTERVAL 10632u
#define B_LIGHT 10720u
#define B_BUILDS 10800u
#define B_VISIBLE 10804u
#define B_CHECKS 10808u
#define B_CONST 18400u
#define B_CACHE 24000u
#define B_SLOTS 27u
static void b_imm(unsigned r,uint32_t value) {
  e(ENC_RI(OP_LUI,r,value>>12));e(ADD_RI(r,value&4095));
}
static void b_inc(unsigned address) {
  sr(2,address);e(ADD_RI(2,1));e(MOV_RI(0,address));f(OP_STORE32,2,0);
}
/* Unsigned 32-bit mixing with high-word feedback; output is a 24-bit fraction.
 * Deliberately uses only existing integer arithmetic and conversion opcodes. */
static void b_random(void) {
  b_imm(2,1664525);f(OP_MUL_RR,3,2);b_imm(2,1013904223);f(OP_ADD_RR,3,2);
  f(OP_MOV_RR,5,3);e(MOV_RI(2,65536));f(OP_DIV_RR,5,2);f(OP_ADD_RR,3,5);
  f(OP_MOV_RR,5,3);e(MOV_RI(2,256));f(OP_DIV_RR,5,2);f(OP_ITOF,4,5);
  sl(5,B_CONST+8);f(OP_FDIV_RR,4,5);
}
/* floor(position / cell width), including negative coordinates. */
static void b_origin(unsigned position) {
  for(unsigned k=0;k<3;k++) {
    sl(4,position+k*8);sl(5,B_CONST);f(OP_FDIV_RR,4,5);f(OP_FTOI,5,4);f(OP_ITOF,6,5);
    f(OP_FCMP_RR,4,6);size_t exact=pc++;e(SUB_RI(5,1));f(OP_ITOF,6,5);code[exact]=ENC_I24(OP_JGE,pc);
    ss(6,B_ORIGIN+k*8);
  }
}
/* B_CELL -> B_PROXY. Radius zero means an empty region. */
static void b_generate(void) {
  loadf(4,ZERO);for(unsigned k=0;k<8;k++)ss(4,B_PROXY+k*8);
  b_imm(3,0x41535452u);
  for(unsigned k=0;k<3;k++) {sl(4,B_CELL+k*8);f(OP_FTOI,5,4);f(OP_ADD_RR,3,5);b_random();}
  b_random();sl(5,B_CONST+16);f(OP_FCMP_RR,4,5);size_t empty=pc++;
  for(unsigned k=0;k<3;k++) {
    b_random();sl(5,B_CONST+24);f(OP_FMUL_RR,4,5);sl(5,B_CONST+32);f(OP_FADD_RR,4,5);
    sl(5,B_CELL+k*8);sl(6,B_CONST);f(OP_FMUL_RR,5,6);f(OP_FADD_RR,4,5);ss(4,B_PROXY+k*8);
  }
  /* Static annulus, 2.2–3.2 AU; full thickness one AU. */
  sl(4,B_PROXY);f(OP_FMUL_RR,4,4);sl(5,B_PROXY+16);f(OP_FMUL_RR,5,5);f(OP_FADD_RR,4,5);
  sl(5,B_CONST+40);f(OP_FCMP_RR,4,5);size_t inner=pc++;
  sl(5,B_CONST+48);f(OP_FCMP_RR,4,5);size_t outer=pc++;
  sl(4,B_PROXY+8);f(OP_FMUL_RR,4,4);sl(5,B_CONST+56);f(OP_FCMP_RR,4,5);size_t high=pc++;
  b_random();f(OP_FMUL_RR,4,4);f(OP_FMUL_RR,4,4);f(OP_FMUL_RR,4,4);
  sl(5,B_CONST+64);f(OP_FMUL_RR,4,5);loadf(5,8512);f(OP_FADD_RR,4,5);ss(4,B_PROXY+24);
  sl(5,S_CONST+8);f(OP_FADD_RR,4,5);ss(4,B_PROXY+32);
  for(unsigned k=0;k<3;k++) {b_random();sl(5,B_CONST+72);f(OP_FMUL_RR,4,5);sl(5,B_CONST+80);f(OP_FADD_RR,4,5);ss(4,B_PROXY+40+k*8);}
  /* Exclude overlaps with the permanent catalogue, including safety shells. */
  size_t overlaps[S_CATALOG];
  for(unsigned b=0;b<S_CATALOG;b++) {
    loadf(4,ZERO);
    for(unsigned k=0;k<3;k++) {sl(5,B_PROXY+k*8);sl(6,S_BODY+b*64+k*8);f(OP_FSUB_RR,5,6);f(OP_FMUL_RR,5,5);f(OP_FADD_RR,4,5);}
    sl(5,S_BODY+b*64+32);sl(6,B_PROXY+32);f(OP_FADD_RR,5,6);f(OP_FMUL_RR,5,5);f(OP_FCMP_RR,4,5);overlaps[b]=pc++;
  }
  size_t done=pc++;
  code[empty]=ENC_I24(OP_JGE,pc);code[inner]=JL(pc);code[outer]=JG(pc);code[high]=JG(pc);
  for(unsigned b=0;b<S_CATALOG;b++)code[overlaps[b]]=ENC_I24(OP_JLE,pc);
  loadf(4,ZERO);for(unsigned k=0;k<8;k++)ss(4,B_PROXY+k*8);
  code[done]=JMP(pc);
}
static void b_cell_offset(int x,int y,int z) {
  const int offsets[]={x,y,z};
  for(unsigned k=0;k<3;k++) {
    sl(4,B_ORIGIN+k*8);e(MOV_RI(2,1));f(OP_ITOF,5,2);
    if(offsets[k])f(offsets[k]>0?OP_FADD_RR:OP_FSUB_RR,4,5);
    ss(4,B_CELL+k*8);
  }
}
static void b_update(void) {
  b_origin(S_POS);sr(2,B_VALID);e(CMP_RI(2,0));size_t fresh=pc++;
  size_t changed[3];
  for(unsigned k=0;k<3;k++){sl(4,B_ORIGIN+k*8);sl(5,B_CACHED+k*8);f(OP_FCMP_RR,4,5);changed[k]=pc++;}
  size_t same=pc++;
  code[fresh]=ENC_I24(OP_JE,pc);for(unsigned k=0;k<3;k++)code[changed[k]]=JNE(pc);
  si(B_VALID,1);b_inc(B_BUILDS);
  for(unsigned k=0;k<3;k++){sl(4,B_ORIGIN+k*8);ss(4,B_CACHED+k*8);}
  unsigned slot=0;
  for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++,slot++) {
    b_cell_offset(x,y,z);b_generate();
    for(unsigned k=0;k<8;k++){sl(4,B_PROXY+k*8);ss(4,B_CACHE+slot*64+k*8);}
  }
  code[same]=JMP(pc);
}
/* Runtime iteration: share render and nearest-clearance code across 27 slots. */
static size_t b_slots_begin(void) {
  si(B_INDEX,0);size_t loop=pc;
  sr(5,B_INDEX);e(MOV_RI(2,64));f(OP_MUL_RR,5,2);e(ADD_RI(5,B_CACHE));
  for(unsigned k=0;k<8;k++) {f(OP_FLOAD64,4,5);ss(4,B_PROXY+k*8);e(ADD_RI(5,8));}
  return loop;
}
static void b_slots_end(size_t loop) {
  b_inc(B_INDEX);e(CMP_RI(2,B_SLOTS));e(JL(loop));
}
static void b_render(void) {
  si(B_VISIBLE,0);size_t loop=b_slots_begin();
  sl(4,B_PROXY+24);loadf(5,ZERO);f(OP_FCMP_RR,4,5);size_t empty=pc++;
  size_t rejected[5];s_frustum(S_CATALOG,rejected);
  s_camera(S_CATALOG,0);sl(5,B_PROXY+24);e(MOV_RI(2,400));f(OP_ITOF,6,2);f(OP_FMUL_RR,5,6);
  f(OP_FCMP_RR,7,5);size_t small=pc++;
  /* Sun direction is evaluated relative to this generated object. */
  loadf(4,ZERO);
  for(unsigned k=0;k<3;k++){sl(5,B_PROXY+k*8);f(OP_FMUL_RR,5,5);f(OP_FADD_RR,4,5);}
  sroot();
  for(unsigned k=0;k<3;k++){loadf(5,ZERO);sl(6,B_PROXY+k*8);f(OP_FSUB_RR,5,6);f(OP_FDIV_RR,5,4);ss(5,B_LIGHT+k*8);}
  b_inc(B_VISIBLE);for(unsigned face=0;face<20;face++)s_face(S_CATALOG,face,true);
  code[empty]=ENC_I24(OP_JLE,pc);code[small]=JG(pc);for(unsigned k=0;k<5;k++)code[rejected[k]]=JL(pc);
  b_slots_end(loop);
}
static void b_nearest(void) {
  size_t loop=b_slots_begin();sl(4,B_PROXY+24);loadf(5,ZERO);f(OP_FCMP_RR,4,5);size_t empty=pc++;
  s_delta(S_CATALOG);sroot();sl(5,B_PROXY+32);f(OP_FSUB_RR,4,5);sl(5,S_CLEAR);f(OP_FCMP_RR,4,5);size_t farther=pc++;
  ss(4,S_CLEAR);si(S_NEAREST,S_CATALOG);
  code[empty]=ENC_I24(OP_JLE,pc);code[farther]=ENC_I24(OP_JGE,pc);b_slots_end(loop);
}
static void b_hit(void) {
  sl(4,B_PROXY+24);loadf(5,ZERO);f(OP_FCMP_RR,4,5);size_t empty=pc++;
  s_delta(S_CATALOG);loadf(9,ZERO);
  for(unsigned k=0;k<3;k++){sl(5,8800+k*8);sl(6,S_DIR+k*8);f(OP_FMUL_RR,5,6);f(OP_FADD_RR,9,5);}
  loadf(5,ZERO);f(OP_FCMP_RR,9,5);size_t behind=pc++;
  ss(9,8832);loadf(10,ZERO);
  for(unsigned k=0;k<3;k++){sl(5,S_DIR+k*8);f(OP_FMUL_RR,5,9);sl(6,8800+k*8);f(OP_FSUB_RR,6,5);f(OP_FMUL_RR,6,6);f(OP_FADD_RR,10,6);}
  sl(4,B_PROXY+32);f(OP_FMUL_RR,4,4);f(OP_FSUB_RR,4,10);loadf(5,ZERO);f(OP_FCMP_RR,4,5);size_t miss=pc++;
  sroot();sl(9,8832);f(OP_FSUB_RR,9,4);sl(5,S_CONST+8);f(OP_FSUB_RR,9,5);
  loadf(5,ZERO);f(OP_FCMP_RR,9,5);size_t positive=pc++;copy(9,5);code[positive]=ENC_I24(OP_JGE,pc);
  sl(5,S_STEP);f(OP_FCMP_RR,9,5);size_t farther=pc++;
  ss(9,S_STEP);si(S_MODE,0);si(S_EVENT,2);e(MOV_RI(11,0));
  code[empty]=ENC_I24(OP_JLE,pc);code[behind]=ENC_I24(OP_JLE,pc);code[miss]=JL(pc);code[farther]=ENC_I24(OP_JGE,pc);
}
static void b_sweep(void) {
  si(B_CHECKS,0);sl(4,S_STEP);loadf(5,ZERO);f(OP_FCMP_RR,4,5);size_t idle=pc++;
  ss(5,B_TRAVEL);
  /* Samples are at most half a cell apart. Their 3x3x3 neighbourhoods cover
   * the entire segment and all rock safety spheres; no cache truncation. */
  size_t loop=pc;
  for(unsigned k=0;k<3;k++){sl(4,S_DIR+k*8);sl(5,B_TRAVEL);f(OP_FMUL_RR,4,5);sl(5,S_POS+k*8);f(OP_FADD_RR,4,5);ss(4,B_SAMPLE+k*8);}
  b_origin(B_SAMPLE);
  for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++) {
    b_cell_offset(x,y,z);b_generate();b_inc(B_CHECKS);b_hit();
  }
  sl(4,B_TRAVEL);sl(5,S_STEP);f(OP_FCMP_RR,4,5);size_t done=pc++;
  sl(6,B_CONST+88);f(OP_FADD_RR,4,6);f(OP_FCMP_RR,4,5);size_t shorter=pc++;
  copy(4,5);code[shorter]=ENC_I24(OP_JLE,pc);ss(4,B_TRAVEL);e(JMP(loop));
  code[done]=ENC_I24(OP_JGE,pc);code[idle]=ENC_I24(OP_JLE,pc);
}
static void b_init_data(void) {
  const double values[]={3e6,16777216,.75,3e6-40,20,
    (2.2*149.6e6)*(2.2*149.6e6),(3.2*149.6e6)*(3.2*149.6e6),
    (.5*149.6e6)*(.5*149.6e6),7.5,.3,.7,1.5e6};
  for(unsigned k=0;k<sizeof(values)/sizeof(values[0]);k++)s_data64(B_CONST+k*8,values[k]);
}
